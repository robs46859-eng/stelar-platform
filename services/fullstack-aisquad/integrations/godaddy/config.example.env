# GoDaddy API Configuration
# Get your API key/secret at: https://developer.godaddy.com/keys
GO_DADDY_API_KEY=your_api_key_here
GO_DADDY_API_SECRET=your_api_secret_here

# Set to 1 to use the sandbox/test environment
GO_DADDY_SANDBOX=1

# Rate limit settings (optional, defaults shown)
# GO_DADDY_RATE_LIMIT=150
# GO_DADDY_RATE_WINDOW=60
